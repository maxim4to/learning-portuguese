{
  "name": "learning-portuguese",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tts": "tsx scripts/tts.ts",
    "validate": "tsx scripts/validate.ts",
    "test:rules": "firebase emulators:exec --project demo-rules-test --only firestore \"tsx --test scripts/rules.test.ts\"",
    "deploy": "tsx scripts/deploy-rules.ts",
    "emulators": "firebase emulators:start --only firestore,auth",
    "lexicon": "tsx scripts/lexicon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:lint": "vitest run scripts/brazilianisms.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc -p tsconfig.test.json",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:e2e:emulator": "firebase emulators:exec --project demo-ptpt --only firestore,auth \"playwright test -c playwright.emulator.config.ts\"",
    "test:all": "npm run test:types && npm test && npm run validate && npm run test:e2e && npm run test:rules && npm run test:e2e:emulator"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/sofia-sans-extra-condensed": "^5.3.0",
    "firebase": "^13.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "firebase-tools": "^15.34.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
