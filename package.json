{
  "name": "learning-portuguese",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tts": "tsx scripts/tts.ts",
    "validate": "tsx scripts/validate.ts",
    "test:rules": "firebase emulators:exec --project demo-rules-test --only firestore \"tsx --test scripts/rules.test.ts\"",
    "deploy": "tsx scripts/deploy-rules.ts",
    "emulators": "firebase emulators:start --only firestore,auth",
    "test:lint": "tsx --test scripts/brazilianisms.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/sofia-sans-extra-condensed": "^5.3.0",
    "firebase": "^13.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
