# Firebase web app config (Firebase console → Project settings → Your apps → Web).
# Leave empty to run fully locally (progress in browser localStorage, no sign-in).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google account emails allowed to read/write Firestore, comma-separated (substituted into firestore.rules
# by `npm run deploy`). Each account sees only its own data under users/{uid}.
# Legacy single ALLOWED_EMAIL= is still accepted if ALLOWED_EMAILS is not set.
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
