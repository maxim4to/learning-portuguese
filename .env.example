# Firebase web app config (Firebase console → Project settings → Your apps → Web).
# Leave empty to run fully locally (progress in browser localStorage, no sign-in).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google account email allowed to read/write Firestore (substituted into firestore.rules by `npm run deploy`).
ALLOWED_EMAIL=
