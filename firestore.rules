rules_version = '2';

// Private app: only the listed Google accounts (matched by verified email) may read/write,
// and each one only under users/{their own uid} — progress is never shared between accounts.
//
// The allowed emails are NOT committed: keep the REPLACE_WITH_YOUR_EMAIL placeholder here.
// `npm run deploy` (scripts/deploy-rules.ts) substitutes ALLOWED_EMAILS from .env into the line marked
// ALLOWED_EMAILS and deploys the generated copy; scripts/rules.test.ts rewrites the same line, so keep the marker comment.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowedEmails() {
      return ['REPLACE_WITH_YOUR_EMAIL']; // ALLOWED_EMAILS
    }

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() in allowedEmails();
    }

    // SRS cards: the newer review wins (src/data/store.ts `newerCard`). An update may not replace a card that
    // was reviewed later — e.g. an older review queued offline on one device arriving after a newer one from
    // another device. The rejected write is resolved on the client (firestoreBackend.ts commit: server version kept).
    function reviewAt(data) {
      return data.get('fsrs', {}).get('last_review', 0);
    }
    function notOlderReview() {
      return !(reviewAt(resource.data) is number)
        || !(reviewAt(request.resource.data) is number)
        || reviewAt(request.resource.data) >= reviewAt(resource.data);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /cards/{cardId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if isOwner(uid) && notOlderReview();
      }

      // Everything else under the user (progress, errors, words, meta, …).
      match /{col}/{rest=**} {
        allow read, write: if isOwner(uid) && col != 'cards';
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
